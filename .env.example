# Demo needs no credentials. Copy to .env.local for optional integrations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional 1Click partner token; server only. Anonymous quotes may be supported.
ONECLICK_API_TOKEN=
# Optional OpenAI-compatible vision model. Endpoint must be trusted by the operator.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Never put private keys or seed phrases here.

# Optional guarded real mainnet payments. OFF by default.
LIVE_PAYMENTS_ENABLED=false
# Server ONLY. Supabase service_role/secret key; NEVER prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional current 1Click X-API-Key, if supplied by your partner account.
ONECLICK_API_KEY=
